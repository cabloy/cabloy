{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "exclude": [
    "**/cli/**",
    "**/dist/**",
    "./dist",
    "./dist-releases",
    "./coverage",
    "./.app",
    "./.app-test-*",
    "./.vona",
    "./.vona-test-*",
    "./.zova-rest",
    "./node_modules",
    "./packages-cli",
    "./packages-utils",
    "./packages-vona"
  ]
}
