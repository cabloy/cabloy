import type { TableIdentity } from 'table-identity';
import type { TypeQueryInput, TypeQueryGroupInput, TypeQueryAggregateInput } from 'vona-module-a-orm';
import type { IRbacScopeAccess } from 'vona-module-a-rbac';
import type { IDecoratorControllerOptions } from 'vona-module-a-web';

import { BeanBase } from 'vona';
import { Api, Mcp, Resource, v } from 'vona-module-a-openapiutils';
import { $compileQuery } from 'vona-module-a-orm';
import { z } from 'zod';
import { Passport } from 'vona-module-a-user';
import { Arg, Controller, Web } from 'vona-module-a-web';

import { <%=argv.resourceName%>Query } from '../lib/<%=argv.resourceName%>Query.ts';

import { $locale } from '../.metadata/locales.ts';
import { Dto<%=argv.resourceNameCapitalize%>Create } from '../dto/<%=argv.resourceName%>Create.tsx';
import { Dto<%=argv.resourceNameCapitalize%>DeleteBulk } from '../dto/<%=argv.resourceName%>DeleteBulk.tsx';
import { Dto<%=argv.resourceNameCapitalize%>SelectReq } from '../dto/<%=argv.resourceName%>SelectReq.tsx';
import { Dto<%=argv.resourceNameCapitalize%>SelectRes } from '../dto/<%=argv.resourceName%>SelectRes.tsx';
import { Dto<%=argv.resourceNameCapitalize%>Update } from '../dto/<%=argv.resourceName%>Update.tsx';
import { Dto<%=argv.resourceNameCapitalize%>View } from '../dto/<%=argv.resourceName%>View.tsx';
import { Dto<%=argv.resourceNameCapitalize%>GroupResItem } from '../dto/<%=argv.resourceName%>GroupResItem.tsx';
import { Dto<%=argv.resourceNameCapitalize%>AggregateRes } from '../dto/<%=argv.resourceName%>AggregateRes.tsx';
import { <%=argv.resourceName%>Analysis } from '../lib/<%=argv.resourceName%>Analysis.ts';

export interface IControllerOptions<%=argv.resourceNameCapitalize%> extends IDecoratorControllerOptions {}

@Controller<IControllerOptions<%=argv.resourceNameCapitalize%>>('<%=argv.resourceName%>', {
  summary: $locale('<%=argv.resourceNameCapitalize%>Controller'),
})
@Resource()
export class Controller<%=argv.resourceNameCapitalize%> extends BeanBase {
  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>CreateDescription'),
    readOnly: false,
  })
  @Web.post('', { summary: $locale('<%=argv.resourceNameCapitalize%>Create') })
  @Api.body(v.tableIdentity())
  @Passport.rbac({ dataScope: true })
  async create(
    @Arg.body() <%=argv.resourceName%>: Dto<%=argv.resourceNameCapitalize%>Create,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<TableIdentity> {
    return (await this.scope.service.<%=argv.resourceName%>.create({
      ...<%=argv.resourceName%>,
      ...rbacScopeCurrent.ownerValues(),
    })).id;
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>SelectDescription'),
    readOnly: true,
    discovery: { output: [['list', 'items']] },
  })
  @Web.get('', { summary: $locale('<%=argv.resourceNameCapitalize%>Select') })
  @Api.body(Dto<%=argv.resourceNameCapitalize%>SelectRes)
  @Passport.rbac({ dataScope: true })
  async select(
    @Arg.filter(Dto<%=argv.resourceNameCapitalize%>SelectReq) params: TypeQueryInput<typeof <%=argv.resourceName%>Query>,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<Dto<%=argv.resourceNameCapitalize%>SelectRes> {
    const query = $compileQuery(this.scope.model.<%=argv.resourceName%>, <%=argv.resourceName%>Query, params, { scopeWhere: rbacScopeCurrent.where() });
    return await this.scope.service.<%=argv.resourceName%>.select(query);
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>GroupDescription'),
    readOnly: true,
  })
  @Web.get('group', { summary: $locale('<%=argv.resourceNameCapitalize%>Group') })
  @Api.body(v.array(v.object(Dto<%=argv.resourceNameCapitalize%>GroupResItem)))
  @Passport.rbac({ dataScope: true, actionInherit: 'select' })
  async group(
    @Arg.filter(Dto<%=argv.resourceNameCapitalize%>SelectReq, { mode: 'group' }) params: TypeQueryGroupInput<typeof <%=argv.resourceName%>Query, typeof <%=argv.resourceName%>Analysis>,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<Dto<%=argv.resourceNameCapitalize%>GroupResItem[]> {
    const query = $compileQuery(this.scope.model.<%=argv.resourceName%>, <%=argv.resourceName%>Query, params, { mode: 'group', analysis: <%=argv.resourceName%>Analysis, scopeWhere: rbacScopeCurrent.where() });
    return await this.scope.service.<%=argv.resourceName%>.group(query);
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>AggregateDescription'),
    readOnly: true,
  })
  @Web.get('aggregate', { summary: $locale('<%=argv.resourceNameCapitalize%>Aggregate') })
  @Api.body(Dto<%=argv.resourceNameCapitalize%>AggregateRes)
  @Passport.rbac({ dataScope: true, actionInherit: 'select' })
  async aggregate(
    @Arg.filter(Dto<%=argv.resourceNameCapitalize%>SelectReq, { mode: 'aggregate' }) params: TypeQueryAggregateInput<typeof <%=argv.resourceName%>Query, typeof <%=argv.resourceName%>Analysis>,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<Dto<%=argv.resourceNameCapitalize%>AggregateRes> {
    const query = $compileQuery(this.scope.model.<%=argv.resourceName%>, <%=argv.resourceName%>Query, params, { mode: 'aggregate', analysis: <%=argv.resourceName%>Analysis, scopeWhere: rbacScopeCurrent.where() });
    return await this.scope.service.<%=argv.resourceName%>.aggregate(query);
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>ViewDescription'),
    readOnly: true,
  })
  @Web.get(':id', { summary: $locale('<%=argv.resourceNameCapitalize%>View') })
  @Api.body(v.optional(), v.object(Dto<%=argv.resourceNameCapitalize%>View))
  @Passport.rbac({ dataScope: true })
  async view(
    @Arg.param('id', v.tableIdentity()) id: TableIdentity,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<Dto<%=argv.resourceNameCapitalize%>View | undefined> {
    const data = await this.scope.service.<%=argv.resourceName%>.view(id);
    rbacScopeCurrent.checkEntry(data);
    return data;
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>UpdateDescription'),
    readOnly: false,
  })
  @Web.patch(':id', { summary: $locale('<%=argv.resourceNameCapitalize%>Update') })
  @Api.body(z.null())
  @Passport.rbac({ dataScope: true })
  async update(
    @Arg.param('id', v.tableIdentity()) id: TableIdentity,
    @Arg.body() <%=argv.resourceName%>: Dto<%=argv.resourceNameCapitalize%>Update,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<void> {
    const data = await this.scope.model.<%=argv.resourceName%>.getById(id);
    rbacScopeCurrent.checkEntry(data);
    await this.scope.service.<%=argv.resourceName%>.update(id, <%=argv.resourceName%>);
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>DeleteDescription'),
    readOnly: false,
  })
  @Web.delete(':id', { summary: $locale('<%=argv.resourceNameCapitalize%>Delete') })
  @Api.body(z.null())
  @Passport.rbac({ dataScope: true })
  async delete(
    @Arg.param('id', v.tableIdentity()) id: TableIdentity,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<void> {
    const data = await this.scope.model.<%=argv.resourceName%>.getById(id);
    rbacScopeCurrent.checkEntry(data);
    await this.scope.service.<%=argv.resourceName%>.delete(id);
  }

  @Mcp.tool({
    ssrSites: ['<%=argv.ssrSiteOnionName%>'],
    description: $locale('<%=argv.resourceNameCapitalize%>DeleteBulkDescription'),
    readOnly: false,
  })
  @Web.post('bulk/delete', { summary: $locale('BulkDelete') })
  @Api.body(z.null())
  @Passport.rbac({ dataScope: true, actionInherit: 'delete' })
  async deleteBulk(
    @Arg.body() command: Dto<%=argv.resourceNameCapitalize%>DeleteBulk,
    @Arg.rbacScopeCurrent() rbacScopeCurrent: IRbacScopeAccess,
  ): Promise<void> {
    const entries = await this.bean.rbacResourceBulk.entries(
      command.ids,
      async ids => {
        return await this.scope.model.<%=argv.resourceName%>.select({
          where: rbacScopeCurrent.where({ id: ids }),
        });
      },
      rbacScopeCurrent,
    );
    await this.scope.service.<%=argv.resourceName%>.deleteBulk(entries.map(entry => entry.id));
  }
}
