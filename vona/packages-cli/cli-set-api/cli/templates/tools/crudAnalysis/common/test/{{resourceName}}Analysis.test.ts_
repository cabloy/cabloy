import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { describe, it } from 'node:test';
import { app } from 'vona-mock';
import { $makeSchema, v } from 'vona-module-a-openapiutils';

import { <%=argv.resourceName%>Analysis } from '../src/lib/<%=argv.resourceName%>Analysis.ts';

describe('<%=argv.resourceName%>Analysis.test.ts', { concurrency: false }, () => {
  it('returns default and requested-only string counts with validated controls', async () => {
    await app.bean.executor.mockCtx(async () => {
      const scope = app.scope('<%=argv.moduleInfo.relativeName%>');
      const name = `__analysis_${randomUUID()}`;
      const fixture = await scope.model.<%=argv.resourceName%>.insert({ name });
      try {
        await app.bean.passport.signinMock();
        const where = { field: 'id', op: 'eq', value: $makeSchema(v.tableIdentity()).parse(fixture.id) } as const;
        const serviceWhere = { id: fixture.id };
        const queries = [
          { name },
          { where: JSON.stringify(where) },
        ];
        const select = await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>', {
          query: { where: JSON.stringify(where), orders: JSON.stringify([{ field: 'id', direction: 'asc' }]), pageNo: 1, pageSize: 1 },
        });
        assert.equal(select.total, '1');
        assert.equal(select.list[0].id, fixture.id);
        assert.equal((await scope.service.<%=argv.resourceName%>.select({ where: serviceWhere, limit: 1 })).total, '1');
        for (const query of queries) {
          const groups = await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/group', { query });
          assert.deepEqual(groups, [{ name, count_all: '1' }]);
          assert.deepEqual(await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/group', {
            query: { ...query, groups: JSON.stringify(['name']), aggrs: JSON.stringify({ count: ['*'] }) },
          }), groups);
          assert.deepEqual(await scope.service.<%=argv.resourceName%>.group({
            where: serviceWhere, groups: ['name'], aggrs: { count: ['*'] },
          }), groups);
          const aggregate = await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/aggregate', { query });
          assert.deepEqual(aggregate, { count_all: '1' });
          assert.deepEqual(await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/aggregate', {
            query: { ...query, aggrs: JSON.stringify({ count: ['*'] }) },
          }), aggregate);
          assert.deepEqual(await scope.service.<%=argv.resourceName%>.aggregate({
            where: serviceWhere, aggrs: { count: ['*'] },
          }), aggregate);
        }
        for (const action of ['group', 'aggregate'] as const) {
          for (const controls of [
            // Analysis accepts only public predicates and analysis selections.
            { pageNo: 2, pageSize: 1 },
            { columns: JSON.stringify(['id']) },
            { orders: JSON.stringify([{ field: 'name', direction: 'desc' }]) },
            { where: JSON.stringify({ id: fixture.id }) },
            { aggrs: JSON.stringify({}) },
            { aggrs: JSON.stringify({ count: ['*', '*'] }) },
            { aggrs: JSON.stringify({ count: ['unknown'] }) },
            { aggrs: '{invalid-json' },
          ]) {
            await assert.rejects(() => app.bean.executor.performAction('get', `<%=argv.moduleActionPathRaw%>/${action}`, {
              query: { name, ...controls },
            }));
          }
        }
        // The shared policy does not enable analysis controls on ordinary select.
        await assert.rejects(() => app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>', {
          query: { name, aggrs: JSON.stringify({ count: ['*'] }) },
        }));
        for (const groups of [[], ['name', 'name'], ['description'], ['unknown']]) {
          await assert.rejects(() => app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/group', {
            query: { name, groups: JSON.stringify(groups) },
          }));
        }
        await assert.rejects(() => scope.service.<%=argv.resourceName%>.group({ where: serviceWhere, aggrs: { count: [] } }));
        assert.deepEqual(<%=argv.resourceName%>Analysis.defaults.group, {
          groups: ['name'], aggrs: { count: ['*'] },
        });
        await assert.rejects(() => app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/aggregate', {
          query: { name, groups: JSON.stringify(['name']) },
        }));
        await assert.rejects(() => scope.service.<%=argv.resourceName%>.aggregate({ where: serviceWhere, aggrs: { count: [] } }));
        assert.deepEqual(<%=argv.resourceName%>Analysis.defaults.aggregate, { aggrs: { count: ['*'] } });
        await scope.model.<%=argv.resourceName%>.deleteById(fixture.id);
        for (const query of queries) {
          assert.deepEqual(await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/group', { query }), []);
          assert.deepEqual(await app.bean.executor.performAction('get', '<%=argv.moduleActionPathRaw%>/aggregate', { query }), { count_all: '0' });
        }
      } finally {
        await scope.model.<%=argv.resourceName%>.deleteById(fixture.id, { disableDeleted: true });
        await app.bean.passport.signout();
      }
    });
  });
});
