import { $defineAnalysis } from 'vona-module-a-orm';

import { Model<%=argv.resourceNameCapitalize%> } from '../model/<%=argv.resourceName%>.ts';

// One allowlist drives request controls, response fields, and bounded execution.
export const <%=argv.resourceName%>Analysis = $defineAnalysis(() => Model<%=argv.resourceNameCapitalize%>, {
  groups: [<% if (argv.groupBy) { %>'<%=argv.groupBy%>'<% } %>],
  aggrs: { count: ['*'] },
  defaults: {
<% if (argv.groupBy) { %>    group: { groups: ['<%=argv.groupBy%>'], aggrs: { count: ['*'] } },
<% } %><% if (argv.aggregate) { %>    aggregate: { aggrs: { count: ['*'] } },
<% } %>  },
  limits: { maxGroups: 3, maxMetrics: 10, maxGroupRows: 1000 },
});
