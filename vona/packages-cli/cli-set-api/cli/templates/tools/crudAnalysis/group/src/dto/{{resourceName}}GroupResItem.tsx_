import type { IDecoratorDtoOptions } from 'vona-module-a-web';

<% if (argv.groupBy === 'description') { %>import { $Class } from 'vona';
import { $makeSchema } from 'vona-module-a-openapiutils';
import z from 'zod';
<% } %>import { $Dto } from 'vona-module-a-orm';
import { Dto } from 'vona-module-a-web';

import { <%=argv.resourceName%>Analysis } from '../lib/<%=argv.resourceName%>Analysis.ts';

export interface IDtoOptions<%=argv.resourceNameCapitalize%>GroupResItem extends IDecoratorDtoOptions {}

<% if (argv.groupBy === 'description') { %>@Dto<IDtoOptions<%=argv.resourceNameCapitalize%>GroupResItem>({
  fields: { description: $makeSchema(z.string().nullable().optional()) },
})
export class Dto<%=argv.resourceNameCapitalize%>GroupResItem extends $Class.omit(
  $Dto.analysisGroup(<%=argv.resourceName%>Analysis),
  ['description'],
) {
  description?: string | null;
}
<% } else { %>@Dto<IDtoOptions<%=argv.resourceNameCapitalize%>GroupResItem>()
export class Dto<%=argv.resourceNameCapitalize%>GroupResItem extends $Dto.analysisGroup(<%=argv.resourceName%>Analysis) {}
<% } %>