{
  "name": "vona-module-image-native",
  "version": "5.0.0",
  "description": "",
  "keywords": [
    "Vona Module"
  ],
  "author": "",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/index.d.ts"
      ],
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "tsc:publish": "npm run clean && node ../../../../../packages-cli/cli/src/bin/vona.ts :bin:buildModule --sourcemap && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run tsc:publish",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "clean-package": "^2.2.0",
    "rimraf": "^6.1.3"
  },
  "clean-package": {
    "indent": 2,
    "remove": [
      "clean-package",
      "exports.\\..import"
    ]
  },
  "title": "image-native",
  "vonaModule": {
    "dependencies": {
      "a-image": "5.0.0"
    },
    "globalDependencies": {
      "sharp": true
    },
    "bundle": {
      "replaces": [
        [
          "sharp = require(`../src/build/Release/sharp-${runtimePlatform}-${version}.node`);",
          "sharp = globalThis.__app__;"
        ]
      ]
    }
  }
}
