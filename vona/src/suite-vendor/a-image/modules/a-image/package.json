{
  "name": "vona-module-a-image",
  "version": "5.0.1",
  "description": "",
  "keywords": [
    "Vona Module"
  ],
  "author": "",
  "files": [
    "assets",
    "cli",
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/index.d.ts"
      ],
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "tsc:publish": "npm run clean && node ../../../../../packages-cli/cli/src/bin/vona.ts :bin:buildModule --sourcemap && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run tsc:publish",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "devDependencies": {
    "clean-package": "^2.2.0",
    "rimraf": "^6.1.3"
  },
  "clean-package": {
    "indent": 2,
    "remove": [
      "clean-package",
      "exports.\\..import"
    ]
  },
  "title": "a-image",
  "vonaModule": {
    "fileVersion": 1,
    "dependencies": {
      "a-orm": "5.0.0",
      "a-schedule": "5.0.0",
      "a-upload": "5.0.0",
      "a-user": "5.0.0",
      "a-web": "5.0.0"
    },
    "onions": {
      "imageProvider": {
        "optionsGlobalInterfaceName": "IDecoratorImageProviderOptions",
        "optionsGlobalInterfaceFrom": "vona-module-a-image",
        "scopeResource": true,
        "boilerplate": "imageProvider/boilerplate"
      },
      "imageScene": {
        "optionsGlobalInterfaceName": "IDecoratorImageSceneOptions",
        "optionsGlobalInterfaceFrom": "vona-module-a-image",
        "boilerplate": "imageScene/boilerplate"
      }
    }
  }
}
