{
  "name": "vona-module-a-markdown",
  "version": "5.0.3",
  "description": "",
  "keywords": [
    "Vona Module"
  ],
  "author": "",
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/index.d.ts"
      ],
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "tsc:publish": "npm run clean && node ../../../../../packages-cli/cli/src/bin/vona.ts :bin:buildModule --sourcemap && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run tsc:publish",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-list": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-youtube": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/static-renderer": "^3.30.0",
    "lowlight": "^3.3.0",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "clean-package": "^2.2.0",
    "rimraf": "^6.1.3"
  },
  "clean-package": {
    "indent": 2,
    "remove": [
      "clean-package",
      "devDependencies",
      "exports.\\..import"
    ]
  },
  "title": "a-markdown",
  "vonaModule": {
    "dependencies": {
      "a-image": "5.0.0",
      "a-vona": "5.0.0"
    }
  }
}
