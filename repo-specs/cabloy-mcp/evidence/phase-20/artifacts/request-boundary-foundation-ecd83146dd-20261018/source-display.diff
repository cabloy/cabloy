+export function spanFixture(throwEnd = false) {
+  const counts = { exception: 0, status: 0, attribute: 0, end: 0, name: 0 };
+  const span = {
+    recordException() {
+      counts.exception++;
+      return span;
+    },
+    setStatus() {
+      counts.status++;
+      return span;
+    },
+    setAttribute() {
+      counts.attribute++;
+      return span;
+    },
+    setAttributes() {
+      counts.attribute++;
+      return span;
+    },
+    updateName() {
+      counts.name++;
+      return span;
+    },
+    end() {
+      counts.end++;
+      if (throwEnd) throw new Error();
+    },
+    isRecording() {
+      return true;
+    },
+    spanContext() {
+      return { traceId: '0'.repeat(32), spanId: '0'.repeat(16), traceFlags: 0 };
+    },
+    addEvent() {
+      return span;
+    },
+    addLink() {
+      return span;
+    },
+    addLinks() {
+      return span;
+    },
+  } as unknown as Span;
+  return { span, counts };
+}
