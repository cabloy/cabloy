+      try {
+        const value = await fn();
+        if (expired) throw new Error('MCP_FIXTURE_CASE_DEADLINE');
+        return value;
+      } finally {
+        caseActive = false;
+        activeCaseTimer = undefined;
+        clear(timer);
+        if (startupSettled && closed && counts.active === 0 && operations.size === 0)
+          clear(hardExitTimer);
+      }
+    },
+    close,
+  };
+}
