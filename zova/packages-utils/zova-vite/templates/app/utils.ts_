import { locales } from '../../src/front/config/locales.ts';
<%=sysMonkey?"import { SysMonkey } from '../../src/front/config/monkeySys.ts';":''%>
<%=appMonkey?"import { AppMonkey } from '../../src/front/config/monkey.ts';":''%>
import config from '../config.ts';
import { env } from '../env.ts';
import { modulesMeta } from '../modules-meta.ts';

const options = {
  modulesMeta,
  locales,
  config,
  env,
  viteHot: import.meta.hot,
  <%=sysMonkey?'SysMonkey,':''%>
  <%=appMonkey?'AppMonkey,':''%>
};

export function getPluginZovaOptions() {
  return options;
}
