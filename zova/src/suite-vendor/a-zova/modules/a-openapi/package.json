{
  "name": "zova-module-a-openapi",
  "version": "5.1.40",
  "gitHead": "09d901d17140a80ee0764211b441cda72fd94663",
  "description": "",
  "keywords": [
    "Zova Module"
  ],
  "author": "",
  "files": [
    "dist",
    "mock",
    "src",
    "icons",
    "assets"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": [
        "./src/index.ts",
        "./dist/index.d.ts"
      ],
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "tsc:publish": "npm run clean && node ../../../../../packages-cli/cli/src/bin/zova.ts :bin:buildModule --sourcemap && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run tsc:publish",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "dependencies": {
    "@cabloy/json-schema-to-zod": "^2.6.5",
    "openapi3-ts": "^4.5.0",
    "typestyle": "^2.4.0"
  },
  "devDependencies": {
    "clean-package": "^2.2.0",
    "rimraf": "^6.1.3"
  },
  "clean-package": {
    "indent": 2,
    "replace": {
      "exports.\\..types": "./dist/index.d.ts"
    },
    "remove": [
      "clean-package",
      "devDependencies",
      "exports.\\..import"
    ]
  },
  "title": "a-openapi",
  "zovaModule": {
    "capabilities": {
      "monkey": true
    },
    "dependencies": {
      "a-model": "5.0.0"
    },
    "globalDependencies": {
      "openapi3-ts": true,
      "typestyle": true
    },
    "bundle": {
      "vendors": [
        {
          "match": [
            "@cabloy/json-schema-to-zod",
            "openapi3-ts"
          ],
          "output": "openapi3"
        }
      ]
    }
  }
}
